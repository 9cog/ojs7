# SKZ Agents Framework - Comprehensive .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
auto_commit.log

# Database
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
.pytest_cache/
.coverage
htmlcov/

# Node.js (for React components)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
.pnp.*

# React build
build/
dist/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Models and large files
*.pkl
*.model
*.h5
*.onnx
models/
vector_db/
uploads/

# OJS specific
files/
cache/
config.inc.php
!config.TEMPLATE.inc.php

# Windows PHP distribution (not needed for Linux CI/CD)
php/

# Docker
.dockerignore

# Sensitive data
*.key
*.pem
*.crt
api_keys.txt
secrets.json

# Test results
test-results/
coverage.xml
.coverage.*

# Backup files
*.bak
*.backup
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
# Allow tracked source modules inside autonomous-agents-framework despite global models ignore
!skz-integration/autonomous-agents-framework/src/models/**
!skz-integration/autonomous-agents-framework/src/services/**

# Large files that should be tracked with LFS if needed
# These patterns help prevent accidental commits of large files
# Only ignore specific large generated files:
audit_results.json
tree*.txt
tree*.md

# Additional large file patterns
*.dump
*.sql.gz
*.tar
*.tgz
*.war
*.ear
*.sar
*.class

# IDE and editor files that can get large  
*.code-workspace
.vscode/settings.json

# Generated documentation that can be large
docs/_build/
docs/build/
_site/

# Generated lock files (regenerated by npm install)
package-lock.json

# Added by git-lfs-repair (generated/platform files)
lib/

# Broken LFS pointer files removed during repair (2026-04-26)
# These were test results, reports, and simulation data that got
# tracked via LFS with *.json pattern but objects were never uploaded.
provider_integration_validation_results.json
skz-integration/audit_report.json
skz-integration/autonomous-agents-framework/phase5_final_assessment.json
skz-integration/autonomous-agents-framework/phase5_validation_report.json
skz-integration/autonomous-agents-framework/production_quality_report.json
skz-integration/autonomous-agents-framework/test_results.json
skz-integration/autonomous-agents-framework/tests/comprehensive/master_integration_test_report.json
skz-integration/autonomous-agents-framework/tests/comprehensive/test_results.json
skz-integration/phase5_final_assessment.json
skz-integration/simulation-dashboard/src/assets/simulation_results.json
skz-integration/simulation_results.json
skz-integration/autonomous-agents-framework/data/regulatory/fda_cosmetics.json
skz-integration/autonomous-agents-framework/data/regulatory/inci_names.json

# Platform-specific binaries (should not be in repo)
*.exe
*.dll
*.pdb
*.msi
